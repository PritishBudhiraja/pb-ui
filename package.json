{
  "name": "pb-ui",
  "version": "0.0.0",
  "private": true,
  "description": "Hatch — personal design system and component library",
  "packageManager": "pnpm@10.18.0",
  "scripts": {
    "dev": "pnpm --filter @pritish.budhiraja/docs dev",
    "storybook": "pnpm --filter @pritish.budhiraja/storybook dev",
    "build": "pnpm --filter @pritish.budhiraja/tokens build && pnpm --filter @pritish.budhiraja/ui build",
    "build:docs": "pnpm --filter @pritish.budhiraja/docs build",
    "build:storybook": "pnpm --filter @pritish.budhiraja/storybook build",
    "lint": "biome check . && pnpm --filter @pritish.budhiraja/ui typecheck && pnpm --filter @pritish.budhiraja/docs typecheck",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "pnpm --filter @pritish.budhiraja/ui test",
    "test:coverage": "pnpm --filter @pritish.budhiraja/ui test:coverage",
    "typecheck": "pnpm -r --if-present typecheck",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@changesets/cli": "^3.0.3",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.11.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@parcel/watcher"
    ],
    "overrides": {
      "glob": "^14.0.6",
      "minimatch": "^11.0.1",
      "tinypool": "^2.2.0",
      "uuid": "^11.1.1"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "typescript": "7"
      }
    }
  }
}
